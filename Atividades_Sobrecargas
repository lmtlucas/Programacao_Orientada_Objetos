método para mostrar total
'''
class Produto:
    def __init__(self, nome, preco):
        self.nome = nome
        self.preco = preco

        
class Carrinho:
    def __init__(self):
        self.produtos = []
    def __add__(self, produto):
        return self.produtos.append(produto)
    def total(self):
        total = 0
        for produto in self.produtos:
            total += self.preco
